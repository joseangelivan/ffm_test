
{
  "geocoordinates": {
    "request": {
      "api_config": {
        "base_url": "https://nominatim.openstreetmap.org/search",
        "parameters": {
          "q": {
            "values": [
              "$Address",
              "$city",
              "$state",
              "$country"
            ],
            "separator": ", "
          },
          "format": "json",
          "limit": 1
        }
      }
    },
    "response": {
      "lat": "0.lat",
      "lon": "0.lon"
    }
  },
  "autocomplete": {
    "request": {
      "api_config": {
        "base_url": "https://nominatim.openstreetmap.org/search",
        "parameters": {
          "q": {
            "values": [
              "$Address",
              "$city",
              "$state",
              "$country"
            ],
            "separator": ", "
          },
          "format": "json",
          "addressdetails": 1,
          "limit": 10
        }
      }
    },
    "response": {
      "results_path": ".",
      "address_path": "name",
      "lat_path": "lat",
      "lon_path": "lon",
      "city_path": "address.city",
      "state_path": "address.state",
      "postcode_path": "address.postcode"
    }
  }
}
