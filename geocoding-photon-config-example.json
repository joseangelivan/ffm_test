
{
  "geocoordinates": {
    "request": {
      "api_config": {
        "base_url": "https://photon.komoot.io/api/",
        "parameters": {
          "q": {
            "values": ["$Address", "$city", "$state", "$country"],
            "separator": ", "
          },
          "limit": 5
        }
      }
    },
    "response": {
      "results_path": "features",
      "lat": "geometry.coordinates.1",
      "lon": "geometry.coordinates.0",
      "city_path": "properties.city"
    }
  },
  "autocomplete": {
    "request": {
      "api_config": {
        "base_url": "https://photon.komoot.io/api/",
        "parameters": {
          "q": {
            "values": ["$Address", "$city", "$state", "$country"],
            "separator": ", "
          },
          "lat": {
            "value": "$city_lat",
            "optional": true
          },
          "lon": {
            "value": "$city_lon",
            "optional": true
          },
          "limit": 10
        }
      }
    },
    "response": {
      "results_path": "features",
      "address_path": "properties.name",
      "lat_path": "geometry.coordinates.1",
      "lon_path": "geometry.coordinates.0",
      "city_path": "properties.city",
      "state_path": "properties.state",
      "postcode_path": "properties.postcode"
    }
  }
}

    